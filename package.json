{
  "name": "@wetty/terminal",
  "version": "0.0.0",
  "description": "WeTTY Terminal powered by ghostty-web",
  "main": "index.js",
  "repository": "https://github.com/btwiuse/wetty",
  "author": "navigaid <navigaid@gmail.com>",
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "ghostty-web",
    "ghostty",
    "wetty"
  ],
  "scripts": {
    "start": "concurrently --names tsc,esb -c green.bold,blue.bold --kill-others \"tsc --watch\" \"yarn:bundle --dev\" ",
    "build": "concurrently --success --names tsc,esb -c green.bold,blue.bold tsc yarn:bundle",
    "bundle": "node ./esbuild.config.mjs",
    "clean": "rimraf www/dist",
    "test": "echo 'TODO'"
  },
  "dependencies": {
    "ghostty-web": "github:NimbleMarkets/ghostty-web#nm-kitty-built",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@btwiuse/serve": "1.0.2",
    "@types/node": "25.0.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/styled-components": "^5.1.26",
    "concurrently": "9.2.1",
    "esbuild": "0.28.2",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@1.22.1"
}
